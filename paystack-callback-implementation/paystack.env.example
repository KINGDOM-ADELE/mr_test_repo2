# Paystack server-side configuration
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_SECRET_KEY=REPLACE_WITH_ROTATED_TEST_SECRET_KEY
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_PAYSTACK_TEST_PUBLIC_KEY
PAYSTACK_WEBHOOK_URL=https://YOUR_API_DOMAIN/api/s/v1.00/webhooks/paystack
PAYSTACK_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SIGNING_SECRET
PAYSTACK_CALLBACK_URL=https://YOUR_API_DOMAIN/api/s/v1.00/redirect/paystack
PAYSTACK_ENV=SANDBOX

# Your frontend origin used by the callback controller
FRONTEND_BASE_URL=https://YOUR_FRONTEND_DOMAIN
